{
  "name": "mdtation",
  "version": "0.0.0",
  "description": "Desktop-inspired terminal markdown viewer for the agentic era — inline comments that flow to your clipboard and CLI.",
  "type": "module",
  "license": "MIT",
  "author": "janniks",
  "bin": {
    "mdtation": "./dist/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "node --import tsx --test test/*.test.ts",
    "schema": "node --import tsx scripts/generate-schema.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "citty": "^0.2.0",
    "consola": "^3.4.0",
    "oxfmt": "^0.1.0",
    "oxlint": "^1.0.0",
    "tsdown": "^0.15.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0"
  }
}
