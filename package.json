{
  "name": "mdtation",
  "version": "0.0.0",
  "description": "Desktop-inspired terminal markdown viewer for the agentic era — inline comments that flow to your clipboard and CLI.",
  "license": "MIT",
  "author": "janniks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janniks/mdtation.git"
  },
  "bin": {
    "mdtation": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "bun src/bin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt src test",
    "fmt:check": "oxfmt --check src test",
    "test": "node --import tsx --test test/*.test.ts",
    "schema": "node --import tsx scripts/generate-schema.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "dependencies": {
    "@opentui/core": "^0.5.3",
    "@opentui/react": "^0.5.3",
    "marked": "^18.0.9",
    "react-dom": "^19.2.4",
    "string-width": "^8.2.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "tsdown": "^0.15.12",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
