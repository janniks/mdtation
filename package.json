{
  "name": "mdtation",
  "version": "0.2.4",
  "description": "Desktop-inspired terminal markdown viewer for the agentic era — inline comments that flow to your clipboard and CLI.",
  "license": "MIT",
  "author": "janniks",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/janniks/mdtation.git"
  },
  "bin": {
    "mdtation": "./bin/mdtation.cjs"
  },
  "files": [
    "dist",
    "bin"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "start": "bun src/bin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "fmt": "oxfmt src test",
    "fmt:check": "oxfmt --check src test",
    "test": "node --import tsx --test test/*.test.ts",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "npm run build && changeset publish"
  },
  "dependencies": {
    "@opentui/core": "0.5.3",
    "bun": "1.4.0"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@types/node": "22.20.1",
    "citty": "0.2.2",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "tsdown": "0.15.12",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  }
}
